<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="[ROBOT_NAME]_ros2_control" params="name initial_positions_file plugin:=[DEFAULT_CONTROL_PLUGIN]">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
[ROS2_CONTROL_HARDWARE_PLUGINS]
            </hardware>
[ROS2_CONTROL_JOINTS]
        </ros2_control>
    </xacro:macro>
</robot>
